# Copy to .env.local; never share secrets in chat or commit them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase session pooler runtime URL with SSL.
DATABASE_URL=
# Optional trusted database CA downloaded from Supabase dashboard; keep the PEM outside git.
DATABASE_CA_CERT_PATH=
# Hosted preview alternative: trusted CA PEM contents (server-only).
DATABASE_CA_CERT=
# Direct or session pooler migrations URL, never transaction pooler.
DIRECT_URL=
SUPABASE_PRIVATE_BUCKET=myfarm-private
