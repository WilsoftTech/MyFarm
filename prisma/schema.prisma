generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
}
enum MembershipStatus {
  ACTIVE
  REVOKED
}
enum MembershipRole {
  FARMER
  AGENT
  ADMIN
}
enum OrganizationKind {
  PERSONAL
  ORGANIZATION
}
enum LandOwnership {
  OWNED
  RENTED
  FAMILY
  COMMUNAL
  OTHER
}
enum FarmActivity {
  CROPS
  POULTRY
  OTHER_LIVESTOCK
  OTHER
}
enum AreaUnit {
  ACRE
  HECTARE
  SQUARE_METRE
}
enum FarmMemberRole {
  OWNER
}
enum EnterpriseType {
  CROP
  POULTRY
  DAIRY
  LIVESTOCK
  FISH
  OTHER
}
enum ProductionStatus {
  ACTIVE
  CLOSED
}
enum PoultryPurpose {
  EGGS
  MEAT
  DUAL_PURPOSE
  BREEDING
}
model User {
  id String @id @default(uuid()) @db.Uuid
  authSubject String @unique @db.Uuid
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  memberships Membership[]
  audits AuditEvent[]
  farmer Farmer?
  farmMemberships FarmMember[]
  enterprises Enterprise[]
  seasons Season[]
  cropCycles CropCycle[]
  poultryBatches PoultryBatch[]
  accountingRecords AccountingRecord[]
  payments PaymentRecord[]
  accountingReversals AccountingReversal[]
  harvests Harvest[]
  storageLocations StorageLocation[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  productionEvents ProductionEvent[]
  stockOperations StockOperation[]
  stockAdjustments StockAdjustment[] @relation("AdjustmentCreator")
  approvedStockAdjustments StockAdjustment[] @relation("AdjustmentApprover")
  productionActivities ProductionActivity[] @relation("ActivityCreator")
  completedActivities ProductionActivity[] @relation("ActivityCompleter")
  activityRecurrences ActivityRecurrence[]
  cancelledActivities ProductionActivity[] @relation("ActivityCanceller")
  recordPhotos RecordPhoto[]
  pilotCohorts PilotCohort[]
  pilotParticipations PilotParticipation[] @relation("PilotParticipant")
  pilotConsentsRecorded PilotParticipation[] @relation("PilotPaperConsent")
  pilotUsage PilotUsageEvent[]
  pilotPrompts PilotPrompt[]
  supportIncidents SupportIncident[]
  pilotObservations PilotObservation[]
  pilotFindings PilotFinding[]
  pilotReviews PilotReview[]
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  kind OrganizationKind
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  memberships Membership[]
  audits AuditEvent[]
  farmer Farmer?
  farms Farm[]
  plots Plot[]
  pilotCohorts PilotCohort[]
  pilotUsage PilotUsageEvent[]
}
// Phase2 registry (Q05: one farmer per user, owned by one PERSONAL organization).
model Farmer {
  id String @id @db.Uuid
  userId String @unique @db.Uuid
  tenantId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profile FarmerProfile?
  farms Farm[]
  @@unique([id, tenantId])
}
// Q06: minimal contact/location only. No identity numbers, documents or precise home location.
model FarmerProfile {
  farmerId String @id @db.Uuid
  name String @db.VarChar(120)
  phone String @db.VarChar(16)
  alternativePhone String? @db.VarChar(16)
  district String @db.VarChar(80)
  subcounty String? @db.VarChar(80)
  village String? @db.VarChar(80)
  preferredLanguage String @db.VarChar(16)
  ownershipType LandOwnership
  mainActivities FarmActivity[]
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy String @db.Uuid
  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Restrict)
}
model Farm {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  ownerFarmerId String @db.Uuid
  name String @db.VarChar(120)
  district String @db.VarChar(80)
  subcounty String? @db.VarChar(80)
  village String? @db.VarChar(80)
  approximateAcreage Decimal? @db.Decimal(12, 4)
  ownershipType LandOwnership
  primaryActivity FarmActivity
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy String @db.Uuid
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner Farmer @relation(fields: [ownerFarmerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  plots Plot[]
  members FarmMember[]
  enterprises Enterprise[]
  seasons Season[]
  accountingRecords AccountingRecord[]
  payments PaymentRecord[]
  productionActivities ProductionActivity[]
  activityRecurrences ActivityRecurrence[]
  recordPhotos RecordPhoto[]
  @@unique([id, tenantId])
  @@index([tenantId, createdAt, id])
  harvests Harvest[]
  storageLocations StorageLocation[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  productionEvents ProductionEvent[]
  stockOperations StockOperation[]
  stockAdjustments StockAdjustment[]
}
model Plot {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  name String @db.VarChar(120)
  area Decimal? @db.Decimal(18, 6)
  areaUnit AreaUnit?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy String @db.Uuid
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  cropCycles CropCycle[]
  accountingRecords AccountingRecord[]
  productionActivities ProductionActivity[]
  activityRecurrences ActivityRecurrence[]
  @@unique([id, farmId, tenantId])
  @@unique([farmId, name])
  @@index([tenantId, farmId, createdAt, id])
}
model FarmMember {
  farmId String @db.Uuid
  userId String @db.Uuid
  tenantId String @db.Uuid
  role FarmMemberRole
  status MembershipStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([farmId, userId])
  @@index([userId, status])
}
model Membership {
  userId String @db.Uuid
  organizationId String @db.Uuid
  role MembershipRole
  status MembershipStatus @default(ACTIVE)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@id([userId, organizationId])
  @@index([organizationId, status])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  tenantId String @db.Uuid
  action String @db.VarChar(80)
  targetId String? @db.Uuid
  requestId String @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, requestId, action])
  @@index([tenantId, occurredAt, id])
  @@index([actorId, occurredAt])
}

// Phase3 T001 foundation subset. CropCycle/LivestockBatch detail is added by its own task.
model Enterprise {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  type EnterpriseType
  name String @db.VarChar(120)
  status ProductionStatus @default(ACTIVE)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  cropCycles CropCycle[]
  poultryBatches PoultryBatch[]
  accountingRecords AccountingRecord[]
  productionActivities ProductionActivity[]
  activityRecurrences ActivityRecurrence[]
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([farmId, tenantId])
  @@index([createdBy])
}

model Season {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  label String @db.VarChar(120)
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  status ProductionStatus @default(ACTIVE)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  cropCycles CropCycle[]
  accountingRecords AccountingRecord[]
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([farmId, tenantId])
  @@index([createdBy])
}

// Global reference data, with no farm ownership or runtime administration grants.
model CropCatalog {
  id String @id @db.Uuid
  name String @unique @db.VarChar(120)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cycles CropCycle[]
  @@index([active, createdAt, id])
}

model CropCycle {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  enterpriseId String @db.Uuid
  seasonId String @db.Uuid
  plotId String @db.Uuid
  cropId String @db.Uuid
  // Creation snapshot: catalog renaming does not rewrite historical labels or retry results.
  cropName String @db.VarChar(120)
  variety String? @db.VarChar(120)
  areaPlanted Decimal @db.Decimal(18, 6)
  areaUnit AreaUnit
  plantingDate DateTime @db.Date
  expectedHarvest DateTime? @db.Date
  areaExceptionReason String? @db.VarChar(500)
  status ProductionStatus @default(ACTIVE)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  enterprise Enterprise @relation(fields: [enterpriseId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  season Season @relation(fields: [seasonId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  plot Plot @relation(fields: [plotId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  crop CropCatalog @relation(fields: [cropId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([tenantId, farmId, createdAt, id])
  @@index([plotId, farmId, tenantId, status])
  @@index([enterpriseId, farmId, tenantId])
  @@index([seasonId, farmId, tenantId])
  @@index([cropId])
  @@index([createdBy])
  harvests Harvest[]
  inventoryItems InventoryItem[]
  @@unique([id, farmId, tenantId])
  @@unique([id, plotId, cropId, farmId, tenantId])
}
model AnimalTypeCatalog {
  id String @id @db.Uuid
  name String @unique @db.VarChar(120)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  batches PoultryBatch[]
  @@index([active, createdAt, id])
}
model PoultryBatch {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  enterpriseId String @db.Uuid
  animalTypeId String @db.Uuid
  // Creation snapshot: catalog renaming does not rewrite historical labels or retry results.
  animalTypeName String @db.VarChar(120)
  breed String? @db.VarChar(120)
  batchLabel String @db.VarChar(120)
  // Farm-wide identity (D-P03-010): application-normalized, case/whitespace-insensitive label.
  batchLabelKey String
  startingQuantity Int
  acquisitionDate DateTime @db.Date
  purpose PoultryPurpose
  status ProductionStatus @default(ACTIVE)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  enterprise Enterprise @relation(fields: [enterpriseId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  animalType AnimalTypeCatalog @relation(fields: [animalTypeId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@unique([tenantId, farmId, batchLabelKey])
  @@index([tenantId, farmId, createdAt, id])
  @@index([enterpriseId, farmId, tenantId])
  @@index([animalTypeId])
  @@index([createdBy])
  productionEvents ProductionEvent[]
  inventoryItems InventoryItem[]
  openingMovements StockMovement[]
  costRecords AccountingRecord[]
  @@unique([id, farmId, tenantId])
}
enum AccountingRecordKind {
  EXPENSE
  INCOME
  PURCHASE
  SALE
}
// D-P08-009: which reported cost group a cost category belongs to. Reference data, set by reviewed release.
enum CostGroup {
  LABOUR
  INPUT
}
enum TransactionCategoryKind {
  COST
  REVENUE
}
enum AccountingStatus {
  POSTED
  REVERSED
}
enum PaymentDirection {
  RECEIVED
  MADE
}
// Global reviewed catalogs (D-P04-005); changes only by data-release migration.
model TransactionCategory {
  id String @id @db.Uuid
  kind TransactionCategoryKind
  name String @db.VarChar(120)
  active Boolean @default(true)
  costGroup CostGroup?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  records AccountingRecord[]
  @@unique([kind, name])
  @@index([kind, active, createdAt, id])
}
model PaymentMethod {
  id String @id @db.Uuid
  name String @unique @db.VarChar(120)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  records AccountingRecord[]
  payments PaymentRecord[]
  @@index([active, createdAt, id])
}
// Expense/income/purchase/sale (D-P04-003). Optional analytical links are single-column FKs;
// same-farm consistency is enforced by the service and the runtime INSERT policy.
model AccountingRecord {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  kind AccountingRecordKind
  categoryId String @db.Uuid
  // Creation snapshot: catalog renaming does not rewrite historical meaning.
  categoryName String @db.VarChar(120)
  amount Decimal @db.Decimal(20, 4)
  currency String @db.Char(3)
  occurredOn DateTime @db.Date
  counterparty String? @db.VarChar(120)
  paymentMethodId String? @db.Uuid
  plotId String? @db.Uuid
  enterpriseId String? @db.Uuid
  seasonId String? @db.Uuid
  // D-P08-003: optional, on expenses and purchases only. Sales trace to a batch through their stock event.
  batchId String? @db.Uuid
  status AccountingStatus @default(POSTED)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  category TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  plot Plot? @relation(fields: [plotId], references: [id], onDelete: Restrict)
  enterprise Enterprise? @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  season Season? @relation(fields: [seasonId], references: [id], onDelete: Restrict)
  batch PoultryBatch? @relation(fields: [batchId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  reversal AccountingReversal?
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([farmId, tenantId])
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([plotId])
  @@index([enterpriseId])
  @@index([seasonId])
  @@index([batchId, farmId, tenantId])
  @@index([createdBy])
  productionEvent ProductionEvent?
  stockOperation StockOperation?
  activities ProductionActivity[]
  photos RecordPhoto[]
}
// A payment only settles sale/purchase obligations; its allocations share its status.
model PaymentRecord {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  direction PaymentDirection
  amount Decimal @db.Decimal(20, 4)
  currency String @db.Char(3)
  paidOn DateTime @db.Date
  paymentMethodId String @db.Uuid
  externalReference String? @db.VarChar(120)
  status AccountingStatus @default(POSTED)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  allocations PaymentAllocation[]
  reversal AccountingReversal?
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([farmId, tenantId])
  @@index([paymentMethodId])
  @@index([createdBy])
}
model PaymentAllocation {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  paymentId String @db.Uuid
  obligationId String @db.Uuid
  amount Decimal @db.Decimal(20, 4)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  payment PaymentRecord @relation(fields: [paymentId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  obligation AccountingRecord @relation(fields: [obligationId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  @@unique([paymentId, obligationId])
  @@index([obligationId, farmId, tenantId])
  @@index([paymentId, farmId, tenantId])
}
// Append-only correction (D-P04-002): exactly one of recordId/paymentId, each reversed at most once.
model AccountingReversal {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  recordId String? @unique @db.Uuid
  paymentId String? @unique @db.Uuid
  reason String @db.VarChar(500)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  record AccountingRecord? @relation(fields: [recordId], references: [id], onDelete: Restrict)
  payment PaymentRecord? @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([tenantId, farmId, createdAt, id])
  @@index([createdBy])
}


model StorageLocation {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  name String @db.VarChar(120)
  nameKey String
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  harvests Harvest[]
  movements StockMovement[]
  @@unique([id, farmId, tenantId])
  @@unique([farmId, tenantId, nameKey])
  @@index([tenantId, farmId, createdAt, id])
  @@index([createdBy])
  productionEvents ProductionEvent[]
  outgoingOperations StockOperation[] @relation("OperationSource")
  incomingOperations StockOperation[] @relation("OperationDestination")
}
model InventoryItem {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  name String @db.VarChar(120)
  kind String @db.VarChar(20)
  unit String @db.VarChar(20)
  cropCycleId String? @unique @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  cycle CropCycle? @relation(fields: [cropCycleId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  harvests Harvest[]
  movements StockMovement[]
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([createdBy])
  batchId String? @db.Uuid
  batch PoultryBatch? @relation(fields: [batchId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  @@unique([batchId, kind])
  stockOperations StockOperation[]
  nameKey String?
  @@unique([farmId, tenantId, nameKey, unit])
}
model Harvest {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  cropCycleId String @db.Uuid
  cropId String @db.Uuid
  plotId String @db.Uuid
  storageLocationId String @db.Uuid
  itemId String @db.Uuid
  cropName String @db.VarChar(120)
  storageLocationName String @db.VarChar(120)
  harvestDate DateTime @db.Date
  quantity Decimal @db.Decimal(18,6)
  unit String @db.VarChar(20)
  grade String? @db.VarChar(120)
  lossQuantity Decimal @db.Decimal(18,6)
  requestHash String @db.VarChar(64)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  cycle CropCycle @relation(fields: [cropCycleId, plotId, cropId, farmId, tenantId], references: [id, plotId, cropId, farmId, tenantId], onDelete: Restrict)
  storage StorageLocation @relation(fields: [storageLocationId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  item InventoryItem @relation(fields: [itemId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  movements StockMovement[]
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([cropCycleId, farmId, tenantId])
  @@index([storageLocationId, farmId, tenantId])
  @@index([itemId, farmId, tenantId])
  @@index([createdBy])
  @@unique([id, itemId, storageLocationId, farmId, tenantId])
}
model StockMovement {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  itemId String @db.Uuid
  locationId String @db.Uuid
  harvestId String? @db.Uuid
  quantityDelta Decimal @db.Decimal(18,6)
  reason String @db.VarChar(30)
  sourceKey String @unique @db.VarChar(120)
  occurredOn DateTime @db.Date
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  item InventoryItem @relation(fields: [itemId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
