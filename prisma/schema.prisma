// Phase 6 farm activities. Status is the stored lifecycle only: today, upcoming and missed derive from dueOn (D-P06-002).
enum ActivityType {
  PLANTING
  IRRIGATION
  WEEDING
  SPRAYING
  FERTILIZING
  VACCINATION
  FEEDING
  HARVESTING
  PRUNING
  MILKING
  CLEANING
  INSPECTION
}
enum ActivityStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}
model ProductionActivity {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  type ActivityType
  dueOn DateTime @db.Date
  enterpriseId String? @db.Uuid
  plotId String? @db.Uuid
  status ActivityStatus @default(SCHEDULED)
  workerName String? @db.VarChar(120)
  notes String? @db.VarChar(1000)
  costRecordId String? @db.Uuid
  recurrenceId String? @db.Uuid
  completedAt DateTime? @db.Timestamptz(6)
  completedBy String? @db.Uuid
  cancelledAt DateTime? @db.Timestamptz(6)
  cancelledBy String? @db.Uuid
  cancelReason String? @db.VarChar(500)
  requestHash String @db.VarChar(64)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  version Int @default(1)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  enterprise Enterprise? @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  plot Plot? @relation(fields: [plotId], references: [id], onDelete: Restrict)
  cost AccountingRecord? @relation(fields: [costRecordId], references: [id], onDelete: Restrict)
  recurrence ActivityRecurrence? @relation(fields: [recurrenceId], references: [id], onDelete: Restrict)
  photos RecordPhoto[]
  creator User @relation("ActivityCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  completer User? @relation("ActivityCompleter", fields: [completedBy], references: [id], onDelete: Restrict)
  canceller User? @relation("ActivityCanceller", fields: [cancelledBy], references: [id], onDelete: Restrict)
  @@unique([id, farmId, tenantId])
  @@unique([recurrenceId, dueOn])
  @@index([tenantId, farmId, status, dueOn, id])
  @@index([tenantId, farmId, createdAt, id])
  @@index([farmId, tenantId])
  @@index([enterpriseId])
  @@index([plotId])
  @@index([createdBy])
  @@index([costRecordId])
  @@index([completedBy])
  @@index([cancelledBy])
}

// A series only generates ProductionActivity rows; each occurrence then has its own lifecycle (D-P06-003).
enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
}
model ActivityRecurrence {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  type ActivityType
  frequency RecurrenceFrequency
  interval Int
  startOn DateTime @db.Date
  endOn DateTime? @db.Date
  stoppedFrom DateTime? @db.Date
  expandedThrough DateTime? @db.Date
  enterpriseId String? @db.Uuid
  plotId String? @db.Uuid
  workerName String? @db.VarChar(120)
  notes String? @db.VarChar(1000)
  previousId String? @unique @db.Uuid
  requestHash String @db.VarChar(64)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  version Int @default(1)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  enterprise Enterprise? @relation(fields: [enterpriseId], references: [id], onDelete: Restrict)
  plot Plot? @relation(fields: [plotId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  previous ActivityRecurrence? @relation("RecurrenceChange", fields: [previousId], references: [id], onDelete: Restrict)
  next ActivityRecurrence? @relation("RecurrenceChange")
  occurrences ProductionActivity[]
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([tenantId, farmId, stoppedFrom, expandedThrough])
  @@index([farmId, tenantId])
  @@index([enterpriseId])
  @@index([plotId])
  @@index([createdBy])
}

// Phase 7 interim photo rule (D-P07-004). The ID is also the private object's name under the tenant's prefix.
model RecordPhoto {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  activityId String? @db.Uuid
  accountingRecordId String? @db.Uuid
  contentType String @db.VarChar(40)
  byteSize Int
  sha256 String @db.Char(64)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  activity ProductionActivity? @relation(fields: [activityId], references: [id], onDelete: Restrict)
  accountingRecord AccountingRecord? @relation(fields: [accountingRecordId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([tenantId, farmId, activityId, createdAt])
  @@index([tenantId, farmId, accountingRecordId, createdAt])
  @@index([farmId, tenantId])
  @@index([activityId])
  @@index([accountingRecordId])
  @@index([createdBy])
}

// Phase 9 field pilot (D-P09-001 to D-P09-009). A cohort belongs to the organization running it; a participation is a
// farmer's consented link to it under a pseudonym. Staff see measures and pseudonyms only (D-P09-007).
enum PilotParticipationStatus {
  ENROLLED
  WITHDRAWN
}
enum PilotUsageKind {
  OFFLINE_COMMITTED
  SYNC_REFUSED
}
enum PilotPromptChannel {
  CALL
  SMS
  VISIT
  OTHER
}
enum SupportSeverity {
  LOW
  MEDIUM
  HIGH
}
enum SupportStatus {
  OPEN
  RESOLVED
}
enum SupportCategory {
  SIGN_IN
  SYNC
  DATA_ENTRY
  UNDERSTANDING
  DEVICE
  OTHER
}
model PilotCohort {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  name String @db.VarChar(120)
  // The code staff hand to farmers; it grants nothing but the chance to consent.
  code String @unique @db.VarChar(12)
  consentVersion String @db.VarChar(40)
  startOn DateTime @db.Date
  endOn DateTime @db.Date
  status ProductionStatus @default(ACTIVE)
  version Int @default(1)
  requestId String @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  participations PilotParticipation[]
  prompts PilotPrompt[]
  incidents SupportIncident[]
  observations PilotObservation[]
  findings PilotFinding[]
  reviews PilotReview[]
  @@unique([id, tenantId])
  @@unique([tenantId, requestId])
  @@index([tenantId, createdAt, id])
  @@index([createdBy])
}
model PilotParticipation {
  id String @id @default(uuid()) @db.Uuid
  cohortId String @db.Uuid
  tenantId String @db.Uuid
  userId String @db.Uuid
  pseudonym String @db.VarChar(12)
  status PilotParticipationStatus @default(ENROLLED)
  consentVersion String @db.VarChar(40)
  enrolledOn DateTime @db.Date
  enrolledAt DateTime @default(now()) @db.Timestamptz(6)
  withdrawnAt DateTime? @db.Timestamptz(6)
  paperConsentRef String? @db.VarChar(60)
  paperConsentBy String? @db.Uuid
  version Int @default(1)
  requestId String @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  cohort PilotCohort @relation(fields: [cohortId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user User @relation("PilotParticipant", fields: [userId], references: [id], onDelete: Restrict)
  paperConsentRecorder User? @relation("PilotPaperConsent", fields: [paperConsentBy], references: [id], onDelete: Restrict)
  prompts PilotPrompt[]
  incidents SupportIncident[]
  observations PilotObservation[]
  @@unique([cohortId, userId])
  @@unique([cohortId, pseudonym])
  @@unique([id, tenantId])
  @@index([userId])
  @@index([paperConsentBy])
}
// Written by the push service, once per entry: what reached the server from a phone (D-P09-008).
model PilotUsageEvent {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  actorId String @db.Uuid
  kind PilotUsageKind
  operation String @db.VarChar(40)
  requestId String @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@unique([tenantId, requestId, kind])
  @@index([actorId, occurredAt])
}
// A staff reminder: the farmer's activity that week does not count as voluntary (D-P09-004).
model PilotPrompt {
  id String @id @default(uuid()) @db.Uuid
  cohortId String @db.Uuid
  tenantId String @db.Uuid
  participationId String @db.Uuid
  promptedOn DateTime @db.Date
  channel PilotPromptChannel
  requestId String @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cohort PilotCohort @relation(fields: [cohortId, tenantId], references: [id, tenantId], onDelete: Restrict)
  participation PilotParticipation @relation(fields: [participationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@unique([tenantId, requestId])
  @@index([cohortId, promptedOn])
  @@index([participationId, tenantId])
  @@index([createdBy])
}
model SupportIncident {
  id String @id @default(uuid()) @db.Uuid
  cohortId String @db.Uuid
  tenantId String @db.Uuid
  participationId String? @db.Uuid
  openedOn DateTime @db.Date
  category SupportCategory
  severity SupportSeverity
  // No names or phone numbers: the form says so, and the pseudonym identifies the farmer.
  summary String @db.VarChar(500)
  status SupportStatus @default(OPEN)
  resolvedOn DateTime? @db.Date
  version Int @default(1)
  requestId String @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  cohort PilotCohort @relation(fields: [cohortId, tenantId], references: [id, tenantId], onDelete: Restrict)
  participation PilotParticipation? @relation(fields: [participationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@unique([tenantId, requestId])
  @@index([cohortId, openedOn])
  @@index([participationId, tenantId])
  @@index([createdBy])
}

// Phase 9 R002: dated observation of real use, findings that must cite it, and go/no-go reviews (D-P09-004).
enum PilotObservationKind {
  HESITATION
  CONFUSION
  ERROR
  WORKAROUND
  WORDING
  POSITIVE
}
enum PilotObservedScreen {
  EXPENSE_FORM
  INCOME_FORM
  SALE_OR_PURCHASE_FORM
  HARVEST_FORM
  ACTIVITY_FORM
  STOCK
  OFFLINE_WORK
  FARM_FIGURES
  SIGN_IN
  OTHER
}
enum PilotFindingStatus {
  OPEN
  ACTIONED
  DISMISSED
}
enum PilotReviewDecision {
  CONTINUE
  GO
  NO_GO
}
model PilotObservation {
  id String @id @default(uuid()) @db.Uuid
  cohortId String @db.Uuid
  tenantId String @db.Uuid
  participationId String? @db.Uuid
  observedOn DateTime @db.Date
  screen PilotObservedScreen
  kind PilotObservationKind
  // No names or phone numbers: the code name identifies the farmer.
  note String @db.VarChar(500)
  requestId String @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cohort PilotCohort @relation(fields: [cohortId, tenantId], references: [id, tenantId], onDelete: Restrict)
  participation PilotParticipation? @relation(fields: [participationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  findings PilotFindingEvidence[]
  @@unique([id, tenantId])
  @@unique([tenantId, requestId])
  @@index([cohortId, observedOn])
  @@index([participationId, tenantId])
  @@index([createdBy])
}
model PilotFinding {
  id String @id @default(uuid()) @db.Uuid
  cohortId String @db.Uuid
  tenantId String @db.Uuid
  title String @db.VarChar(160)
  status PilotFindingStatus @default(OPEN)
  version Int @default(1)
  requestId String @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  cohort PilotCohort @relation(fields: [cohortId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  evidence PilotFindingEvidence[]
  @@unique([id, tenantId])
  @@unique([tenantId, requestId])
  @@index([cohortId, createdAt])
  @@index([createdBy])
}
// Each finding points at the observations behind it, in the same organization.
model PilotFindingEvidence {
  findingId String @db.Uuid
  observationId String @db.Uuid
  tenantId String @db.Uuid
  finding PilotFinding @relation(fields: [findingId, tenantId], references: [id, tenantId], onDelete: Restrict)
  observation PilotObservation @relation(fields: [observationId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@id([findingId, observationId])
  @@index([observationId, tenantId])
  @@index([findingId, tenantId])
}
// Append-only: the gate figures are the server's own at the moment of review.
model PilotReview {
  id String @id @default(uuid()) @db.Uuid
  cohortId String @db.Uuid
  tenantId String @db.Uuid
  reviewedOn DateTime @db.Date
  decision PilotReviewDecision
  gateWeek Int?
  retainedVoluntarily Int?
  onboarded Int
  gateMet Boolean?
  atEnd Boolean @default(false)
  reason String @db.VarChar(1000)
  requestId String @db.Uuid
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cohort PilotCohort @relation(fields: [cohortId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@unique([tenantId, requestId])
  @@index([cohortId, reviewedOn])
  @@index([createdBy])
}
