generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum AccountStatus {
  ACTIVE
  SUSPENDED
}
enum MembershipStatus {
  ACTIVE
  REVOKED
}
enum MembershipRole {
  FARMER
  AGENT
  ADMIN
}
enum OrganizationKind {
  PERSONAL
  ORGANIZATION
}
enum LandOwnership {
  OWNED
  RENTED
  FAMILY
  COMMUNAL
  OTHER
}
enum FarmActivity {
  CROPS
  POULTRY
  OTHER_LIVESTOCK
  OTHER
}
enum AreaUnit {
  ACRE
  HECTARE
  SQUARE_METRE
}
enum FarmMemberRole {
  OWNER
}
enum EnterpriseType {
  CROP
  POULTRY
  DAIRY
  LIVESTOCK
  FISH
  OTHER
}
enum ProductionStatus {
  ACTIVE
  CLOSED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  authSubject String @unique @db.Uuid
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  memberships Membership[]
  audits AuditEvent[]
  farmer Farmer?
  farmMemberships FarmMember[]
  enterprises Enterprise[]
  seasons Season[]
  cropCycles CropCycle[]
}
model Organization {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  kind OrganizationKind
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  memberships Membership[]
  audits AuditEvent[]
  farmer Farmer?
  farms Farm[]
  plots Plot[]
}
// Phase2 registry (Q05: one farmer per user, owned by one PERSONAL organization).
model Farmer {
  id String @id @db.Uuid
  userId String @unique @db.Uuid
  tenantId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  profile FarmerProfile?
  farms Farm[]
  @@unique([id, tenantId])
}
// Q06: minimal contact/location only. No identity numbers, documents or precise home location.
model FarmerProfile {
  farmerId String @id @db.Uuid
  name String @db.VarChar(120)
  phone String @db.VarChar(16)
  alternativePhone String? @db.VarChar(16)
  district String @db.VarChar(80)
  subcounty String? @db.VarChar(80)
  village String? @db.VarChar(80)
  preferredLanguage String @db.VarChar(16)
  ownershipType LandOwnership
  mainActivities FarmActivity[]
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  updatedBy String @db.Uuid
  farmer Farmer @relation(fields: [farmerId], references: [id], onDelete: Restrict)
}
model Farm {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  ownerFarmerId String @db.Uuid
  name String @db.VarChar(120)
  district String @db.VarChar(80)
  subcounty String? @db.VarChar(80)
  village String? @db.VarChar(80)
  approximateAcreage Decimal? @db.Decimal(12, 4)
  ownershipType LandOwnership
  primaryActivity FarmActivity
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy String @db.Uuid
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  owner Farmer @relation(fields: [ownerFarmerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  plots Plot[]
  members FarmMember[]
  enterprises Enterprise[]
  seasons Season[]
  @@unique([id, tenantId])
  @@index([tenantId, createdAt, id])
}
model Plot {
  id String @id @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  name String @db.VarChar(120)
  area Decimal? @db.Decimal(18, 6)
  areaUnit AreaUnit?
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  createdBy String @db.Uuid
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  cropCycles CropCycle[]
  @@unique([id, farmId, tenantId])
  @@unique([farmId, name])
  @@index([tenantId, farmId, createdAt, id])
}
model FarmMember {
  farmId String @db.Uuid
  userId String @db.Uuid
  tenantId String @db.Uuid
  role FarmMemberRole
  status MembershipStatus @default(ACTIVE)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@id([farmId, userId])
  @@index([userId, status])
}
model Membership {
  userId String @db.Uuid
  organizationId String @db.Uuid
  role MembershipRole
  status MembershipStatus @default(ACTIVE)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  @@id([userId, organizationId])
  @@index([organizationId, status])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  tenantId String @db.Uuid
  action String @db.VarChar(80)
  targetId String? @db.Uuid
  requestId String @db.Uuid
  occurredAt DateTime @default(now()) @db.Timestamptz(6)
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  tenant Organization @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@unique([tenantId, requestId, action])
  @@index([tenantId, occurredAt, id])
  @@index([actorId, occurredAt])
}

// Phase3 T001 foundation subset. CropCycle/LivestockBatch detail is added by its own task.
model Enterprise {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  type EnterpriseType
  name String @db.VarChar(120)
  status ProductionStatus @default(ACTIVE)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  cropCycles CropCycle[]
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([farmId, tenantId])
  @@index([createdBy])
}

model Season {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  label String @db.VarChar(120)
  startDate DateTime @db.Date
  endDate DateTime? @db.Date
  status ProductionStatus @default(ACTIVE)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  farm Farm @relation(fields: [farmId, tenantId], references: [id, tenantId], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  cropCycles CropCycle[]
  @@unique([id, farmId, tenantId])
  @@index([tenantId, farmId, createdAt, id])
  @@index([farmId, tenantId])
  @@index([createdBy])
}

// Global reference data, with no farm ownership or runtime administration grants.
model CropCatalog {
  id String @id @db.Uuid
  name String @unique @db.VarChar(120)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  cycles CropCycle[]
  @@index([active, createdAt, id])
}

model CropCycle {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  farmId String @db.Uuid
  enterpriseId String @db.Uuid
  seasonId String @db.Uuid
  plotId String @db.Uuid
  cropId String @db.Uuid
  // Creation snapshot: catalog renaming does not rewrite historical labels or retry results.
  cropName String @db.VarChar(120)
  variety String? @db.VarChar(120)
  areaPlanted Decimal @db.Decimal(18, 6)
  areaUnit AreaUnit
  plantingDate DateTime @db.Date
  expectedHarvest DateTime? @db.Date
  areaExceptionReason String? @db.VarChar(500)
  status ProductionStatus @default(ACTIVE)
  version Int @default(1)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  enterprise Enterprise @relation(fields: [enterpriseId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  season Season @relation(fields: [seasonId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  plot Plot @relation(fields: [plotId, farmId, tenantId], references: [id, farmId, tenantId], onDelete: Restrict)
  crop CropCatalog @relation(fields: [cropId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([tenantId, farmId, createdAt, id])
  @@index([plotId, farmId, tenantId, status])
  @@index([enterpriseId, farmId, tenantId])
  @@index([seasonId, farmId, tenantId])
  @@index([cropId])
  @@index([createdBy])
}
