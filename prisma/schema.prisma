  harvest Harvest? @relation(fields: [harvestId, itemId, locationId, farmId, tenantId], references: [id, itemId, storageLocationId, farmId, tenantId], onDelete: Restrict)
  @@index([tenantId, farmId, itemId, locationId, occurredOn, id])
  @@index([locationId, farmId, tenantId])
  @@index([harvestId, farmId, tenantId])
  @@index([createdBy])
  productionEventId String? @db.Uuid
