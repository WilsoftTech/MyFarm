  {
   "schemaname": "public",
   "tablename": "Farm",
   "policyname": "myfarm_server_farm_create",
   "cmd": "INSERT",
   "roles": "{myfarm_runtime}",
   "qual": null,
   "with_check": "(EXISTS ( SELECT 1\n   FROM (\"Farmer\" f\n     JOIN \"Membership\" m ON (((m.\"userId\" = f.\"userId\") AND (m.\"organizationId\" = f.\"tenantId\"))))\n  WHERE ((f.id = \"Farm\".\"ownerFarmerId\") AND (f.\"tenantId\" = \"Farm\".\"tenantId\") AND (f.\"userId\" = \"Farm\".\"createdBy\") AND (m.role = 'FARMER'::\"MembershipRole\") AND (m.status = 'ACTIVE'::\"MembershipStatus\"))))"
  },
  {
   "schemaname": "public",
   "tablename": "Farm",
   "policyname": "myfarm_server_farm_read",
   "cmd": "SELECT",
   "roles": "{myfarm_runtime}",
   "qual": "true",
   "with_check": null
  },
  {
   "schemaname": "public",
   "tablename": "FarmMember",
   "policyname": "myfarm_server_farm_member_create",
   "cmd": "INSERT",
   "roles": "{myfarm_runtime}",
   "qual": null,
   "with_check": "((role = 'OWNER'::\"FarmMemberRole\") AND (status = 'ACTIVE'::\"MembershipStatus\") AND (EXISTS ( SELECT 1\n   FROM (\"Farm\" fa\n     JOIN \"Farmer\" f ON ((f.id = fa.\"ownerFarmerId\")))\n  WHERE ((fa.id = \"FarmMember\".\"farmId\") AND (fa.\"tenantId\" = \"FarmMember\".\"tenantId\") AND (f.\"userId\" = \"FarmMember\".\"userId\")))))"
  },
  {
   "schemaname": "public",
   "tablename": "FarmMember",
   "policyname": "myfarm_server_farm_member_read",
   "cmd": "SELECT",
   "roles": "{myfarm_runtime}",
   "qual": "true",
   "with_check": null
  },
  {
   "schemaname": "public",
   "tablename": "Farmer",
   "policyname": "myfarm_server_farmer_create",
   "cmd": "INSERT",
   "roles": "{myfarm_runtime}",
   "qual": null,
   "with_check": "(EXISTS ( SELECT 1\n   FROM \"Membership\" m\n  WHERE ((m.\"userId\" = \"Farmer\".\"userId\") AND (m.\"organizationId\" = \"Farmer\".\"tenantId\") AND (m.role = 'FARMER'::\"MembershipRole\") AND (m.status = 'ACTIVE'::\"MembershipStatus\"))))"
  },
  {
   "schemaname": "public",
   "tablename": "Farmer",
   "policyname": "myfarm_server_farmer_read",
   "cmd": "SELECT",
   "roles": "{myfarm_runtime}",
   "qual": "true",
   "with_check": null
  },
  {
   "schemaname": "public",
   "tablename": "FarmerProfile",
   "policyname": "myfarm_server_profile_create",
   "cmd": "INSERT",
   "roles": "{myfarm_runtime}",
   "qual": null,
   "with_check": "(EXISTS ( SELECT 1\n   FROM \"Farmer\" f\n  WHERE ((f.id = \"FarmerProfile\".\"farmerId\") AND (f.\"userId\" = \"FarmerProfile\".\"updatedBy\"))))"
  },
  {
   "schemaname": "public",
   "tablename": "FarmerProfile",
   "policyname": "myfarm_server_profile_read",
   "cmd": "SELECT",
   "roles": "{myfarm_runtime}",
   "qual": "true",
   "with_check": null
  },
  {
   "schemaname": "public",
   "tablename": "FarmerProfile",
   "policyname": "myfarm_server_profile_update",
   "cmd": "UPDATE",
   "roles": "{myfarm_runtime}",
   "qual": "true",
   "with_check": "(EXISTS ( SELECT 1\n   FROM \"Farmer\" f\n  WHERE ((f.id = \"FarmerProfile\".\"farmerId\") AND (f.\"userId\" = \"FarmerProfile\".\"updatedBy\"))))"
  },
  {
   "schemaname": "public",
   "tablename": "Membership",
   "policyname": "myfarm_server_membership_read",
   "cmd": "SELECT",
   "roles": "{myfarm_runtime}",
   "qual": "true",
   "with_check": null
  },
  {
   "schemaname": "public",
   "tablename": "Membership",
   "policyname": "myfarm_server_personal_membership_create",
   "cmd": "INSERT",
   "roles": "{myfarm_runtime}",
   "qual": null,
   "with_check": "((role = 'FARMER'::\"MembershipRole\") AND (status = 'ACTIVE'::\"MembershipStatus\") AND (EXISTS ( SELECT 1\n   FROM \"Organization\" o\n  WHERE ((o.id = \"Membership\".\"organizationId\") AND (o.kind = 'PERSONAL'::\"OrganizationKind\")))) AND (NOT (EXISTS ( SELECT 1\n   FROM \"Membership\" m\n  WHERE (m.\"organizationId\" = \"Membership\".\"organizationId\")))))"
  },
  {
