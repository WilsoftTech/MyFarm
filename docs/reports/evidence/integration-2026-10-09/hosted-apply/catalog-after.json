   "tablename": "Organization",
   "policyname": "myfarm_server_personal_organization_create",
   "cmd": "INSERT",
   "roles": "{myfarm_runtime}",
   "qual": null,
   "with_check": "(kind = 'PERSONAL'::\"OrganizationKind\")"
  },
  {
   "schemaname": "public",
   "tablename": "Plot",
   "policyname": "myfarm_server_plot_create",
   "cmd": "INSERT",
   "roles": "{myfarm_runtime}",
   "qual": null,
   "with_check": "(EXISTS ( SELECT 1\n   FROM \"FarmMember\" fm\n  WHERE ((fm.\"farmId\" = \"Plot\".\"farmId\") AND (fm.\"tenantId\" = \"Plot\".\"tenantId\") AND (fm.\"userId\" = \"Plot\".\"createdBy\") AND (fm.status = 'ACTIVE'::\"MembershipStatus\"))))"
  },
